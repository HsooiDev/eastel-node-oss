{
  "products": [
    "`id` int(11) NOT NULL",
    "`name` varchar(150) NOT NULL",
    "`price` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`description` varchar(500) DEFAULT NULL",
    "`is_active` tinyint(1) NOT NULL DEFAULT 1",
    "`sort_order` int(11) NOT NULL DEFAULT 0",
    "`created_at` datetime NOT NULL DEFAULT current_timestamp()",
    "`updated_at` datetime NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()"
  ],
  "postcode_zones": [
    "`id` int(11) NOT NULL",
    "`postcode_start` int(11) NOT NULL",
    "`postcode_end` int(11) NOT NULL",
    "`zone` enum('WM','EM','Labuan') NOT NULL",
    "`description` varchar(100) DEFAULT NULL"
  ],
  "reviews": [
    "`id` int(11) NOT NULL",
    "`order_id` int(11) NOT NULL",
    "`customer_id` int(11) NOT NULL",
    "`rating` tinyint(3) UNSIGNED NOT NULL CHECK (`rating` between 1 and 5)",
    "`review_text` text NOT NULL",
    "`display_mode` enum('public','private') NOT NULL DEFAULT 'public'",
    "`display_name` varchar(40) DEFAULT NULL",
    "`categories` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`categories`))",
    "`status` enum('pending','approved','rejected') NOT NULL DEFAULT 'pending'",
    "`created_at` datetime NOT NULL DEFAULT current_timestamp()",
    "`updated_at` datetime NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()"
  ],
  "customer_vouchers": [
    "`id` int(11) NOT NULL",
    "`customer_id` int(11) NOT NULL",
    "`campaign_id` int(11) DEFAULT NULL",
    "`code` varchar(40) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL",
    "`discount_type` enum('fixed','percent') NOT NULL DEFAULT 'fixed'",
    "`discount_value` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`min_spend` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`max_discount` decimal(10,2) DEFAULT NULL",
    "`status` enum('active','redeemed','expired') NOT NULL DEFAULT 'active'",
    "`order_id` int(11) DEFAULT NULL",
    "`redeemed_amount` decimal(10,2) DEFAULT NULL",
    "`issued_at` timestamp NULL DEFAULT current_timestamp()",
    "`expires_at` datetime DEFAULT NULL",
    "`redeemed_at` datetime DEFAULT NULL"
  ],
  "couriers": [
    "`id` int(11) NOT NULL",
    "`name` varchar(100) NOT NULL",
    "`wm_fee` decimal(10,2) NOT NULL",
    "`em_fee` decimal(10,2) NOT NULL",
    "`labuan_fee` decimal(10,2) NOT NULL",
    "`is_active` tinyint(1) DEFAULT 1",
    "`sort_order` int(11) DEFAULT 0",
    "`created_at` timestamp NULL DEFAULT current_timestamp()"
  ],
  "orders": [
    "`id` int(11) NOT NULL",
    "`customer_id` int(11) NOT NULL",
    "`order_ref` varchar(50) NOT NULL",
    "`full_name` varchar(255) NOT NULL",
    "`email` varchar(255) NOT NULL",
    "`phone` varchar(20) NOT NULL",
    "`alt_phone` varchar(20) DEFAULT NULL",
    "`delivery_address` text NOT NULL",
    "`address_line1` varchar(255) DEFAULT NULL",
    "`address_line2` varchar(255) DEFAULT NULL",
    "`city` varchar(100) DEFAULT NULL",
    "`state` varchar(100) DEFAULT NULL",
    "`country` varchar(100) NOT NULL DEFAULT 'Malaysia'",
    "`postcode` varchar(10) NOT NULL",
    "`zone` enum('WM','EM','Labuan') NOT NULL",
    "`courier_id` int(11) NOT NULL",
    "`courier_name` varchar(100) NOT NULL",
    "`delivery_fee` decimal(10,2) NOT NULL",
    "`sim_fee` decimal(10,2) NOT NULL DEFAULT 10.00",
    "`total_amount` decimal(10,2) NOT NULL",
    "`voucher_code` varchar(40) DEFAULT NULL",
    "`voucher_discount` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`payment_status` enum('pending','paid','failed') DEFAULT 'pending'",
    "`order_status` enum('pending','processing','shipped','delivered','cancelled') DEFAULT 'pending'",
    "`tracking_number` varchar(100) DEFAULT NULL",
    "`bill_code` varchar(100) DEFAULT NULL",
    "`lang` enum('en','ms','zh') NOT NULL DEFAULT 'en'",
    "`email_sent` tinyint(1) NOT NULL DEFAULT 0",
    "`toyyibpay_ref` varchar(100) DEFAULT NULL",
    "`created_at` timestamp NULL DEFAULT current_timestamp()",
    "`updated_at` timestamp NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()"
  ],
  "customers": [
    "`id` int(11) NOT NULL",
    "`name` varchar(255) NOT NULL",
    "`email` varchar(255) NOT NULL",
    "`phone` varchar(20) NOT NULL",
    "`password_hash` varchar(255) NOT NULL",
    "`is_temp_pass` tinyint(1) DEFAULT 1",
    "`created_at` timestamp NULL DEFAULT current_timestamp()",
    "`reset_token` varchar(255) DEFAULT NULL",
    "`reset_expires` datetime DEFAULT NULL",
    "`email_verified` tinyint(1) NOT NULL DEFAULT 0 COMMENT '1 = email verified after registration'"
  ],
  "email_verifications": [
    "`id` int(11) NOT NULL",
    "`email` varchar(255) NOT NULL",
    "`code` varchar(6) NOT NULL",
    "`token` varchar(64) NOT NULL",
    "`verified` tinyint(1) NOT NULL DEFAULT 0",
    "`created_at` timestamp NULL DEFAULT current_timestamp()",
    "`expires_at` datetime NOT NULL"
  ],
  "review_photos": [
    "`id` int(11) NOT NULL",
    "`review_id` int(11) NOT NULL",
    "`file_path` varchar(500) NOT NULL",
    "`sort_order` tinyint(3) UNSIGNED NOT NULL DEFAULT 0",
    "`created_at` datetime NOT NULL DEFAULT current_timestamp()"
  ],
  "settings": [
    "`setting_key` varchar(100) NOT NULL",
    "`setting_value` text NOT NULL",
    "`updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp()"
  ],
  "voucher_campaigns": [
    "`id` int(11) NOT NULL",
    "`name` varchar(120) NOT NULL",
    "`discount_type` enum('fixed','percent') NOT NULL DEFAULT 'fixed'",
    "`discount_value` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`min_spend` decimal(10,2) NOT NULL DEFAULT 0.00",
    "`max_discount` decimal(10,2) DEFAULT NULL",
    "`validity_days` int(11) NOT NULL DEFAULT 30",
    "`is_welcome` tinyint(1) NOT NULL DEFAULT 0",
    "`is_active` tinyint(1) NOT NULL DEFAULT 1",
    "`created_at` timestamp NULL DEFAULT current_timestamp()"
  ]
}