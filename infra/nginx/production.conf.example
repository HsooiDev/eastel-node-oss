# FUTURE PRODUCTION ONLY — NOT ENABLED BY THIS TASK.
# Do not install/include while the PHP site owns eastel.site/www.
# Requires a separate production build, environment, cache directory and Node process
# on 127.0.0.1:3001. Keep staging's independent service on 127.0.0.1:3000.
# After owner-approved cutover, review effective Hostinger/Cloudflare configuration,
# certificates, origin firewall and this complete template with nginx -t.

# Preserve Next.js public caching; force private/API responses to remain no-store.
# Evaluated only after the upstream has responded. Query data never changes origins.
map $uri $eastel_production_cache_control {
    default $upstream_http_cache_control;
    ~^/api(?:/|$) "private, no-store, max-age=0";
    ~^/hs(?:/|$) "private, no-store, max-age=0";
    ~^/(?:en|ms|zh)/(?:account(?:/|$)|thankyou(?:/|$)) "private, no-store, max-age=0";
    ~^/payment(?:/|$) "private, no-store, max-age=0";
}

server {
    listen 80;
    server_name eastel.site www.eastel.site;
    if ($host !~ ^(eastel\.site|www\.eastel\.site)$) { return 421; }
    return 308 https://eastel.site$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name www.eastel.site;
    if ($host != www.eastel.site) { return 421; }
    ssl_certificate     /etc/ssl/certs/eastel.site.pem;
    ssl_certificate_key /etc/ssl/private/eastel.site.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    return 308 https://eastel.site$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name eastel.site;
    if ($host != eastel.site) { return 421; }

    ssl_certificate     /etc/ssl/certs/eastel.site.pem;
    ssl_certificate_key /etc/ssl/private/eastel.site.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;

    # Restore visitors only from verified Cloudflare peers. Direct clients cannot
    # choose their limiter identity through CF-Connecting-IP or forwarded headers.
    # Official ranges checked 2026-10-10: https://www.cloudflare.com/ips/
    # Refresh against the official lists before deployment; requires realip module.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)" always;

    # Do not add a server-wide noindex or strip Next.js's private-page robots tags.
    proxy_hide_header Cache-Control;
    add_header Cache-Control $eastel_production_cache_control always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 1000;
    client_max_body_size 10M;

    # No shared proxy cache. Next.js controls rendering and its own response cache.
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_http_version 1.1;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite the client-supplied forwarding chain (preserves trusted-IP policy).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_read_timeout 60s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_set_header Host eastel.site;

    # The separate production Next.js build serves immutable hashed assets and
    # public images itself. Keep its cache headers and RSC Vary headers intact.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host eastel.site;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}
