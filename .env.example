# Database
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Authentication
JWT_SECRET=

# Payment Gateway (ToyyibPay)
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# ToyyibPay host: https://toyyibpay.com (prod) or https://dev.toyyibpay.com (sandbox)
TOYYIBPAY_BASE_URL=
NEXT_PUBLIC_TOYYIBPAY_BASE_URL=

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TG_SYSTEM_PROMPT=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# AI
GEMINI_API_KEY=

# Google Analytics 4 / Search Console (base64-encoded service account JSON)
GA4_OAUTH_JSON=
GA4_PROPERTY_ID=
GSC_OAUTH_JSON=
GSC_SITE_URL=
# GA4 web tag measurement ID (e.g. G-XXXXXXXXXX). Leave EMPTY on staging —
# production also requires the production build and trusted eastel.site Host.
NEXT_PUBLIC_GA4_ID=

# Cron (shared secret for /api/whatsapp/debounce, /api/admin/cleanup, /api/media/cleanup — see crontab.txt)
CRON_SECRET=

# App
APP_ENV=
# SEO mode is independent of NODE_ENV. Default is staging (noindex).
# Production opt-in MUST be SITE_ENV=production + NEXT_PUBLIC_SITE_URL=https://eastel.site.
# Both are frozen at build time. Rebuild; do not reuse a staging artifact.
SITE_ENV=staging
# Optional non-secret deployed commit/build identifier returned by health endpoints
BUILD_SHA=

# Required for hosted start/release: absolute directory OUTSIDE every app release.
# Runtime-only, shared by all releases; provision permissions and backups separately.
# Local development may leave blank. Do not point this at public/ or a release folder.
MARKETING_SHARE_DIR=
# Separate private poster library, also outside all releases and public web roots.
MARKETING_POSTER_DIR=
# Persistent review images, outside releases/web roots; keep legacy uploads/ relative paths on copy.
REVIEW_UPLOAD_DIR=
# Private WhatsApp attachments, outside web/build roots; back up before release.
# Copy the CONTENTS of old media/wa, preserving month/phone/file relative paths.
WHATSAPP_MEDIA_DIR=
NEXT_PUBLIC_SITE_URL=https://staging.example.test
NEXT_PUBLIC_BASE_URL=https://staging.example.test
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
